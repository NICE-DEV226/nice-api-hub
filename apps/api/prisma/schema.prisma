// NICE-API'HUB Database Schema
// Author: NICE-DEV

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Note: DATABASE_URL doit être défini dans apps/api/.env

// ==================== USERS ====================
model User {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  googleId      String    @unique
  email         String    @unique
  name          String
  avatar        String?
  role          Role      @default(USER)
  plan          Plan      @default(FREE)
  isActive      Boolean   @default(true)
  
  // Admin Security
  adminPin      String?   // Hashed 6-digit PIN for admin access
  adminPinAttempts Int    @default(0)  // Failed attempts counter
  adminPinLockedUntil DateTime?  // Lockout timestamp
  adminSessionToken String?  // Current admin session token
  adminSessionExpiry DateTime?  // Admin session expiry time
  
  // Subscription (agnostic - works with any payment provider)
  subscription  Subscription?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime  @default(now())
  
  // Relations
  apiKeys       ApiKey[]
  apiUsage      ApiUsage[]
  
  @@map("users")
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

// ==================== SUBSCRIPTION (Agnostic) ====================
model Subscription {
  id                    String    @id @default(auto()) @map("_id") @db.ObjectId
  userId                String    @unique @db.ObjectId
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Provider agnostic fields
  provider              String?   // "stripe", "paypal", "paddle", etc.
  providerCustomerId    String?   // Customer ID from provider
  providerSubscriptionId String?  // Subscription ID from provider
  providerPriceId       String?   // Price/Plan ID from provider
  
  status                SubscriptionStatus @default(INACTIVE)
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelAtPeriodEnd     Boolean   @default(false)
  
  // Metadata for any provider-specific data
  metadata              Json?
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

// ==================== API KEYS ====================
model ApiKey {
  id            String      @id @default(auto()) @map("_id") @db.ObjectId
  userId        String      @db.ObjectId
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  name          String
  key           String      @unique  // Hashed key
  keyPreview    String               // "nicedev_live_abc1...xyz9" (for display)
  environment   Environment @default(DEVELOPMENT)
  isActive      Boolean     @default(true)
  
  // Permissions - empty array means all platforms allowed
  permissions   String[]    @default([])
  
  // Rate Limits (overrides plan defaults if set)
  customRateLimit RateLimit?
  
  createdAt     DateTime    @default(now())
  lastUsedAt    DateTime?
  expiresAt     DateTime?
  
  // Relations
  apiUsage      ApiUsage[]
  
  @@map("api_keys")
}

enum Environment {
  DEVELOPMENT
  PRODUCTION
}

type RateLimit {
  requestsPerMinute Int?
  requestsPerHour   Int?
  requestsPerDay    Int?
}

// ==================== API USAGE (Analytics & Logs) ====================
model ApiUsage {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  apiKeyId      String    @db.ObjectId
  apiKey        ApiKey    @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  userId        String    @db.ObjectId
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Request info
  endpoint      String    // "/api/tiktok/download"
  platform      String    // "tiktok"
  method        String    // "GET"
  statusCode    Int       // 200, 400, 500
  
  // Latency tracking (professional approach)
  totalLatency          Int   // Total request time (ms)
  externalServiceLatency Int? // Time waiting for external API (ms)
  internalLatency       Int?  // Our processing time (ms)
  
  // Request metadata
  ipAddress     String?
  userAgent     String?
  country       String?
  
  // Error tracking
  isError       Boolean   @default(false)
  errorMessage  String?
  errorCode     String?
  
  timestamp     DateTime  @default(now())
  
  @@index([userId, timestamp])
  @@index([apiKeyId, timestamp])
  @@index([endpoint, timestamp])
  @@index([platform, timestamp])
  @@map("api_usage")
}

// ==================== API HEALTH (Monitoring) ====================
model ApiHealth {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  
  platform      String    @unique  // "tiktok", "youtube", etc.
  endpoint      String             // "/api/tiktok/download"
  
  // Health status
  status        ApiStatus @default(HEALTHY)
  isHealthy     Boolean   @default(true)  // Deprecated, use status
  lastStatus    Int       @default(200)
  lastError     String?
  
  // Performance metrics (rolling averages)
  avgLatency    Float     @default(0)    // ms
  p95Latency    Float     @default(0)    // 95th percentile
  p99Latency    Float     @default(0)    // 99th percentile
  successRate   Float     @default(100)  // %
  
  // Counters (last 24h rolling window)
  totalRequests     Int   @default(0)
  successfulRequests Int  @default(0)
  failedRequests    Int   @default(0)
  
  // Consecutive errors tracking
  consecutiveErrors Int   @default(0)
  lastSuccessAt     DateTime?
  
  // Status change history
  statusChangedAt   DateTime?
  previousStatus    ApiStatus?
  
  lastCheckedAt DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@map("api_health")
}

enum ApiStatus {
  HEALTHY     // > 95% success rate
  DEGRADED    // 80-95% success rate or high latency
  UNSTABLE    // 50-80% success rate
  DOWN        // < 50% success rate or consecutive errors > threshold
  MAINTENANCE // Manually set by admin
}

// ==================== RATE LIMIT CONFIG ====================
model RateLimitConfig {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  
  plan          Plan      @unique
  
  requestsPerMinute Int
  requestsPerHour   Int
  requestsPerDay    Int
  
  // Burst allowance
  burstLimit    Int       @default(10)
  
  updatedAt     DateTime  @updatedAt
  
  @@map("rate_limit_configs")
}


// ==================== FEEDBACK (Critiques utilisateurs) ====================
model Feedback {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @db.ObjectId
  
  // Feedback content
  type          FeedbackType
  subject       String
  message       String
  
  // Status for admin
  status        FeedbackStatus @default(PENDING)
  adminResponse String?
  respondedAt   DateTime?
  
  createdAt     DateTime  @default(now())
  
  @@index([status, createdAt])
  @@map("feedbacks")
}

enum FeedbackType {
  BUG
  FEATURE
  IMPROVEMENT
  OTHER
}

enum FeedbackStatus {
  PENDING
  REVIEWED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ==================== RATINGS (Notes plateforme) ====================
model Rating {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @unique @db.ObjectId  // Un seul avis par utilisateur
  
  score         Int       // 1-5 étoiles
  comment       String?   // Commentaire optionnel
  
  isPublic      Boolean   @default(true)  // Visible sur landing page
  isApproved    Boolean   @default(false) // Modération admin
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@map("ratings")
}

// ==================== PLAN CHANGE HISTORY ====================
model PlanChangeHistory {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @db.ObjectId
  
  previousPlan  Plan
  newPlan       Plan
  changedBy     String    @db.ObjectId  // Admin who made the change
  changedByEmail String   // For display purposes
  reason        String?   // Optional reason for the change
  
  createdAt     DateTime  @default(now())
  
  @@index([userId, createdAt])
  @@map("plan_change_history")
}

// ==================== ANNOUNCEMENTS (Bannières) ====================
model Announcement {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  
  title         String
  message       String
  type          AnnouncementType  @default(INFO)
  target        AnnouncementTarget  // PUBLIC = landing, USERS = dashboard
  
  // Styling
  bgColor       String?   // Custom background color
  textColor     String?   // Custom text color
  
  // Display settings
  isActive      Boolean   @default(true)
  isPinned      Boolean   @default(false)  // Always show at top
  dismissible   Boolean   @default(true)   // Can users close it?
  
  // Schedule
  startsAt      DateTime  @default(now())
  expiresAt     DateTime?
  
  // Tracking
  createdBy     String    @db.ObjectId
  createdByEmail String
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([target, isActive])
  @@map("announcements")
}

enum AnnouncementType {
  INFO
  SUCCESS
  WARNING
  ERROR
  PROMO
}

enum AnnouncementTarget {
  PUBLIC    // Landing page - pour inciter à s'inscrire
  USERS     // Dashboard - pour les utilisateurs connectés
  ALL       // Les deux
}
