# --- Required -----------------------------------------------------------------
DATABASE_URL=postgres://nah:change-me@localhost:5432/nah
REDIS_URL=redis://localhost:6379
# >= 32 chars each. Generate with: openssl rand -base64 48
# KEY_PEPPER hashes API keys at rest: rotating it invalidates every key.
KEY_PEPPER=
ADMIN_TOKEN=

# --- Server ---------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# Set true when running behind a reverse proxy / load balancer (real client IPs).
TRUST_PROXY=false
# In production /metrics is only exposed if this is set (Bearer token).
METRICS_TOKEN=

# --- Behaviour -------------------------------------------------------------------
CACHE_TTL_SECONDS=600
NEGATIVE_CACHE_TTL_SECONDS=120
UPSTREAM_TIMEOUT_MS=15000
PROVIDER_MAX_CONCURRENCY=20
PROVIDER_MAX_QUEUE=50
# open  = keep serving if Redis is down (availability first)
# closed = answer 503 (strict enforcement)
RATE_LIMIT_FAIL_MODE=open
USAGE_FLUSH_INTERVAL_MS=5000

# --- Extraction engine (yt-dlp) and downloads --------------------------------------------
# yt-dlp powers YouTube, Instagram, Facebook, SoundCloud, LinkedIn, Pinterest and is the fallback for the rest.
YTDLP_ENABLED=true
YTDLP_PATH=yt-dlp
YTDLP_JS_RUNTIME=node
# YouTube blocks many datacenter IPs ("Sign in to confirm you're not a bot"). Fixes, in order of preference:
# a residential/ISP proxy, or a cookies file exported from a logged-in browser (Netscape format).
YTDLP_PROXY=
YTDLP_COOKIES_FILE=
# GET /v1/download: the gateway fetches, merges (ffmpeg) and streams. Each transfer uses bandwidth and CPU.
DOWNLOAD_ENABLED=true
FFMPEG_PATH=ffmpeg
DOWNLOAD_MAX_CONCURRENCY=4
DOWNLOAD_MAX_SECONDS=900
DOWNLOAD_MAX_BYTES=1073741824
# Tests only: disables the SSRF guard. NEVER set in production.
DOWNLOAD_ALLOW_PRIVATE_HOSTS=false

# --- Asynchronous jobs (POST /v1/jobs) and webhooks ---------------------------------------
JOBS_ENABLED=true
JOBS_CONCURRENCY=4
JOBS_MAX_PENDING_PER_ACCOUNT=20
JOBS_TTL_SECONDS=86400
# Delay before each webhook attempt; the number of entries is the maximum number of attempts.
JOBS_WEBHOOK_BACKOFF_MS=0,30000,120000,600000,3600000

# --- Synthetic probes (drive the public /v1/platforms status) ------------------------
PROBES_ENABLED=false
PROBE_INTERVAL_SECONDS=300
# A known-good public URL per platform, JSON:
PROBE_URLS={"youtube":"https://www.youtube.com/watch?v=aqz-KE-bpKQ","instagram":"https://www.instagram.com/bbcnews/reel/CjAAbuMjAHT/","facebook":"https://www.facebook.com/bbcnews/videos/splashdown-nasa-spacex-crew-return/578508686149614/","soundcloud":"https://soundcloud.com/scottbuckley/sanctuary-cc-by","linkedin":"https://www.linkedin.com/posts/nasa_the-universe-is-calling-apply-to-be-a-nasa-activity-7170837163293532160-KxO-","pinterest":"https://www.pinterest.com/pin/739716307575438329/","tiktok":"https://www.tiktok.com/@bbcnews/video/7623948383312465174","twitter":"https://x.com/NASA/status/2042756933686337713","bluesky":"https://bsky.app/profile/bsky.app/post/3mk4lzkrnk22d","dailymotion":"https://www.dailymotion.com/video/x9yfz8u"}
